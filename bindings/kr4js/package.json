{
  "name": "@dickermoshe/kr4js",
  "version": "0.1.0-rc.1",
  "description": "Jewish calendar, zmanim and daily learning schedules for JavaScript. Runs in browsers, Node, Bun, Deno and edge runtimes.",
  "keywords": [
    "zmanim",
    "hebrew-calendar",
    "jewish",
    "daf-yomi",
    "halacha",
    "kosherjava",
    "webassembly"
  ],
  "license": "LGPL-2.1-or-later",
  "author": "Moshe Dicker <dickermoshe@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dickermoshe/kosher-rust.git",
    "directory": "bindings/kr4js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "node": "./dist/node.js",
      "default": "./dist/browser.js"
    },
    "./slim": {
      "types": "./dist/slim.d.ts",
      "default": "./dist/slim.js"
    },
    "./kr4js.wasm": {
      "types": "./dist/wasm/module.d.ts",
      "default": "./dist/wasm/kr4js_bg.wasm"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/node.js",
  "module": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "slim": [
        "./dist/slim.d.ts"
      ],
      "kr4js.wasm": [
        "./dist/wasm/module.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/browser.js",
    "./dist/node.js"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "npm run build && npm test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:bun": "bun --bun vitest run",
    "test:rust": "cargo test -p kr4js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
