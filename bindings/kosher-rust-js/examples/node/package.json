{
  "name": "kosher-rust-example-node",
  "private": true,
  "description": "A command line app that prints the day's Hebrew date, zmanim and learning. Runs on Node and Bun.",
  "type": "module",
  "bin": {
    "zmanim": "./src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "start:bun": "bun src/cli.js",
    "test": "node --test",
    "test:bun": "bun test",
    "typecheck": "tsc -p jsconfig.json"
  },
  "dependencies": {
    "kosher-rust": "file:../.."
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
